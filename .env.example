# Copia este archivo como `.env` y reemplaza los valores.
# NUNCA subas `.env` al repositorio ni pongas aquí datos reales de clientes.

# --- Base de datos local (Docker) ---
POSTGRES_USER=crm_dev
POSTGRES_PASSWORD=cambia-esta-contrasena-local
POSTGRES_DB=crm_dev
POSTGRES_PORT=5432

# Cadena de conexión que usará la aplicación (debe coincidir con los valores de arriba).
DATABASE_URL=postgresql://crm_dev:cambia-esta-contrasena-local@127.0.0.1:5432/crm_dev

# --- Autenticación (Better Auth) ---
# Secreto para firmar sesiones y cifrar secretos de 2FA. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# URL pública de la app (en local: http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000

# --- Administrador inicial (solo lo usa `npm run db:seed` si no existe ningún usuario) ---
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@ejemplo.local
# Mínimo 12 caracteres. Cámbiala después del primer inicio de sesión.
SEED_ADMIN_PASSWORD=

# --- Cifrado de identificadores sensibles (Medicare, Medicaid, miembro, confirmación) ---
# 32 bytes en base64. Generar CADA UNA por separado con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠ Si se pierde FIELD_ENCRYPTION_KEY, los datos cifrados NO se pueden recuperar.
#   Respáldala en un gestor de contraseñas, separada de los backups de la base.
FIELD_ENCRYPTION_KEY=
# Llave para búsquedas exactas sobre datos cifrados (índice ciego). Debe ser distinta.
BLIND_INDEX_KEY=

# --- Respaldos (npm run db:backup / db:restore-test) ---
# 32 bytes en base64, DISTINTA de las demás. Guárdala en el gestor de contraseñas, nunca junto a
# los respaldos: sin ella no se pueden restaurar, y con ella cualquiera puede leerlos.
BACKUP_ENCRYPTION_KEY=
