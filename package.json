{
  "name": "crm-seguros",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "db:logs": "docker compose logs -f db",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.26",
    "lucide-react": "1.75.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "papaparse": "5.7.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.92.0",
    "read-excel-file": "9.3.14",
    "sonner": "2.0.8",
    "write-excel-file": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher": false,
    "@swc/core": false
  }
}
